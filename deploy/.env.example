# Copy this file to ".env" in this folder, fill it in, then:  chmod 600 .env
# Never commit the real .env.

# ---------------------------------------------------------------- site
# Your domain. Caddy gets and renews the HTTPS certificate for it automatically.
# Point the domain's DNS at this server first. Use ":80" for a plain-HTTP trial without a domain.
SITE_ADDRESS=lolorunner.example
# "production" or "staging". On either, the app refuses to start if a setting is unsafe.
ENVIRONMENT=production

# ---------------------------------------------------------------- database
POSTGRES_USER=lolo
# Letters and digits only (it is placed inside a URL). Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=lolo_runner

# ---------------------------------------------------------------- security
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me
COOKIE_SECURE=true
# One proxy (Caddy) sits in front of the API.
TRUSTED_PROXIES=1
CORS_ORIGINS='["https://lolorunner.example"]'
FRONTEND_URL=https://lolorunner.example
PUBLIC_BASE_URL=https://lolorunner.example
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_TERMS_ACCEPTANCE=true
# Seven days. Sessions can be revoked (a password change signs everyone out), so longer is safe.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REGISTRATION_HOLD_MINUTES=30

# ---------------------------------------------------------------- M-Pesa (Daraja)
# Production credentials come from Safaricom after go-live approval. Use "sandbox" on staging.
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Leave empty for a Paybill. For Buy Goods, set the till number here and
# MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline below.
MPESA_PARTY_B=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# A long random value that is part of the callback URL. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MPESA_CALLBACK_SECRET=
# Comma-separated IPs from Safaricom's own documentation. Empty means no IP check.
MPESA_CALLBACK_IPS=
# MPESA_VERIFY_CALLBACKS is left unset on purpose: that means "verify every callback with Safaricom" in production.

# ---------------------------------------------------------------- email (SMTP relay from a transactional email provider)
EMAIL_BACKEND=smtp
EMAIL_FROM=no-reply@lolorunner.example
EMAIL_FROM_NAME=Lolo Runner
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------- SMS (Africa's Talking)
SMS_BACKEND=africastalking
AT_ENV=production
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---------------------------------------------------------------- Google sign-in (optional)
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- error tracking (optional)
SENTRY_DSN=

# ---------------------------------------------------------------- backups (read by backup.sh)
BACKUP_KEEP_DAYS=14
# Optional off-site copy through rclone, for example "b2:lolo-backups". See README.md.
BACKUP_RCLONE_REMOTE=
