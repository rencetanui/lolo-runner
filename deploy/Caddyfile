# Caddy serves the built frontend and forwards API traffic to the backend.
#
# SITE_ADDRESS is your domain: Caddy then obtains and renews the HTTPS certificate by itself (the domain's DNS
# must already point at this server, and ports 80 and 443 must be open). Use ":80" for a plain-HTTP trial.
{$SITE_ADDRESS} {
	encode zstd gzip

	log {
		output stdout
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Start in report-only mode: open the site, watch the browser console for "Content-Security-Policy"
		# messages, fix anything legitimate that is listed, then rename this header to
		# "Content-Security-Policy" to enforce it. Check the Google lines against Google's current guidance.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: https:; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Everything the backend owns. The 6 MB cap matches the 5 MB image-upload limit.
	@backend path /api/* /media/* /share/* /health /health/*
	handle @backend {
		request_body {
			max_size 6MB
		}
		reverse_proxy api:8000
	}

	# Everything else is the single-page app.
	handle {
		root * /srv

		# Hashed build files never change, so they can be cached forever. Everything else (including the
		# index.html that points at them) must be re-checked, or a new release could load stale files.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notassets not path /assets/*
		header @notassets Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
